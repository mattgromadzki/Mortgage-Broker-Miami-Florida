---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Start Your Miami Mortgage Review | Purchase, Refinance & Preapproval";
const description = "Start a guided Miami mortgage review for purchase, refinance, condo, jumbo, FHA, investor, and self-employed borrower scenarios. Includes purchase price and down payment fields.";
---
<BaseLayout title={title} description={description}>
<main id="main"><section class="funnel-shell" aria-labelledby="start-funnel-title"><div class="funnel-card"><div class="funnel-intro"><p class="eyebrow">Miami mortgage start</p><h1 id="start-funnel-title">Start Your Mortgage Review</h1><p class="hero-copy">Answer a few questions so a licensed mortgage professional can review your purchase, refinance, condo, jumbo, FHA, investor, or self-employed mortgage scenario.</p><div class="trust-row compact-trust"><span class="trust-pill">Matthew Gromadzki</span><span class="trust-pill">NMLS #2560919</span><span class="trust-pill">Miami-Dade & Florida</span></div></div><form id="start-funnel-form" class="start-funnel" data-start-funnel><div class="funnel-progress"><span class="progress-meter" data-progress-meter></span></div><p class="step-label" data-step-label>Step 1 of 7</p><fieldset class="funnel-step is-active" data-step="1"><legend>What can I help you with?</legend><div class="choice-grid"><label class="choice-card"><input type="radio" name="loan_goal" value="Buy a home" required> <span>Buy a home</span></label><label class="choice-card"><input type="radio" name="loan_goal" value="Get preapproved"> <span>Get preapproved</span></label><label class="choice-card"><input type="radio" name="loan_goal" value="Refinance"> <span>Refinance</span></label><label class="choice-card"><input type="radio" name="loan_goal" value="Cash-out refinance"> <span>Cash-out refinance</span></label><label class="choice-card"><input type="radio" name="loan_goal" value="Finance a condo"> <span>Finance a condo</span></label><label class="choice-card"><input type="radio" name="loan_goal" value="Buy an investment property"> <span>Investment property</span></label><label class="choice-card"><input type="radio" name="loan_goal" value="Not sure yet"> <span>Not sure yet</span></label></div></fieldset><fieldset class="funnel-step" data-step="2"><legend>Where is the property?</legend><label>City / area<select name="property_city" required><option value="">Select area</option><option>Miami</option><option>Brickell</option><option>Miami Beach</option><option>Coral Gables</option><option>Doral</option><option>Hialeah</option><option>Homestead</option><option>Aventura</option><option>Sunny Isles Beach</option><option>Kendall</option><option>Pinecrest</option><option>Coconut Grove</option><option>Edgewater Miami</option><option>Other Miami-Dade area</option><option>Other Florida city</option></select></label><label>Property address, building, or ZIP if known<input name="property_address" placeholder="Example: Brickell condo, Miami Beach, 33139"></label></fieldset><fieldset class="funnel-step" data-step="3"><legend data-price-step-title>Purchase price and down payment</legend><div data-purchase-fields><div class="form-row"><label>Estimated purchase price<input name="purchase_price" inputmode="numeric" placeholder="$750,000" data-money-input data-purchase-price></label><label>Planned down payment<input name="down_payment" inputmode="numeric" placeholder="$75,000 or 10" data-money-input data-down-payment></label></div><div class="mini-choice-row"><label><input type="radio" name="down_payment_type" value="dollar" checked> Dollar amount</label><label><input type="radio" name="down_payment_type" value="percent"> Percentage</label></div></div><div class="is-hidden" data-refinance-fields><div class="form-row"><label>Estimated property value<input name="estimated_home_value" inputmode="numeric" placeholder="$750,000" data-money-input data-home-value></label><label>Current mortgage balance<input name="current_mortgage_balance" inputmode="numeric" placeholder="$520,000" data-money-input data-current-balance></label></div><label>Cash-out amount desired, if any<input name="cash_out_amount" inputmode="numeric" placeholder="$50,000" data-money-input data-cash-out></label></div><div class="estimate-box"><span>Estimated loan amount</span><strong data-loan-estimate>Enter numbers to estimate</strong><small data-ltv-estimate>Loan-to-value will show here.</small></div></fieldset><fieldset class="funnel-step" data-step="4"><legend>What type of property and use?</legend><div class="form-row"><label>Property type<select name="property_type" required><option value="">Select property type</option><option>Single-family home</option><option>Condo</option><option>Townhouse</option><option>2–4 unit property</option><option>Mixed-use property</option><option>Not sure</option></select></label><label>Occupancy<select name="occupancy" required><option value="">Select occupancy</option><option>Primary residence</option><option>Second home</option><option>Investment property</option><option>Not sure</option></select></label></div></fieldset><fieldset class="funnel-step" data-step="5"><legend>Credit and income profile</legend><div class="form-row"><label>Credit score range<select name="credit_score" required><option value="">Select range</option><option>760+</option><option>720–759</option><option>680–719</option><option>640–679</option><option>620–639</option><option>580–619</option><option>Below 580</option><option>Not sure</option></select></label><label>Income type<select name="income_type" required><option value="">Select income type</option><option>W-2 employee</option><option>Self-employed</option><option>Business owner</option><option>1099 contractor</option><option>Real estate investor</option><option>Foreign national</option><option>Retired / asset-based income</option><option>Not sure</option></select></label></div></fieldset><fieldset class="funnel-step" data-step="6"><legend>Timing and scenario details</legend><div class="form-row"><label>Timeline<select name="timeline" required><option value="">Select timeline</option><option>Already under contract</option><option>Making offers now</option><option>Buying within 30 days</option><option>Buying within 60–90 days</option><option>Planning ahead</option><option>Refinance as soon as possible</option></select></label><label>Preferred contact method<select name="preferred_contact_method" required><option value="">Select method</option><option>Phone call</option><option>Text</option><option>Email</option><option>Any method is fine</option></select></label></div><label>Anything important about the scenario?<textarea name="scenario_notes" rows="4" placeholder="Example: condo building, jumbo loan, self-employed income, low down payment, investment property, foreign national, closing date, etc."></textarea></label></fieldset><fieldset class="funnel-step" data-step="7"><legend>Where should we send your review?</legend><div class="form-row"><label>First name<input name="first_name" required></label><label>Last name<input name="last_name" required></label></div><div class="form-row"><label>Phone<input name="phone" required></label><label>Email<input name="email" type="email" required></label></div><label class="consent-check"><input type="checkbox" name="contact_consent" value="Yes" required><span>By submitting this form, I agree that Mortgage Broker Miami Florida, Matthew Gromadzki, and/or affiliated mortgage professionals may contact me by phone, text, or email regarding my mortgage request. Consent is not required as a condition of obtaining a loan. Message and data rates may apply.</span></label><p class="form-note">This form is not a loan application, loan approval, rate lock, or commitment to lend. Loan options are subject to borrower qualifications, property review, underwriting, and program availability.</p></fieldset><div class="funnel-actions"><button class="btn btn-secondary" type="button" data-funnel-back>Back</button><button class="btn btn-primary" type="button" data-funnel-next>Next</button><button class="btn btn-primary" type="button" data-funnel-submit onclick="alert('Thank you. A licensed mortgage professional will review your request and follow up.')">Send My Mortgage Review</button></div></form></div><aside class="funnel-side-card"><h2>What happens next?</h2><ol class="clean-list numbered-list"><li>Your scenario is organized by goal, price, down payment/equity, credit range, property type, and timeline.</li><li>A mortgage professional reviews likely loan paths such as FHA, conventional, jumbo, condo, DSCR, bank statement, or refinance.</li><li>You receive a follow-up for documents, numbers, and next steps before any loan application or underwriting decision.</li></ol><div class="side-cta-box"><strong>Prefer to talk now?</strong><a href="tel:+13059884806">Call (305) 988-4806</a><a href="sms:+17863708570">Text (786) 370-8570</a></div></aside></section><section class="section soft"><div class="container split-grid"><div><p class="eyebrow">Why this funnel is better than a contact form</p><h2>It captures the numbers needed for a real mortgage conversation.</h2><p>A generic contact form usually gives only a name, phone number, and email. This guided intake collects the details that matter: purchase price, down payment, property city, property type, credit range, occupancy, income type, and timeline.</p></div><div class="check-card"><h3>Purchase path includes</h3><ul class="check-list"><li>Estimated purchase price</li><li>Down payment as dollars or percentage</li><li>Estimated loan amount</li><li>Estimated loan-to-value</li><li>Property city and type</li><li>Credit and income profile</li></ul></div></div></section></main>
<script is:inline>(()=>{const form=document.querySelector('[data-start-funnel]');if(!form)return;const steps=[...form.querySelectorAll('[data-step]')],nextBtn=form.querySelector('[data-funnel-next]'),backBtn=form.querySelector('[data-funnel-back]'),submitBtn=form.querySelector('[data-funnel-submit]'),label=form.querySelector('[data-step-label]'),meter=form.querySelector('[data-progress-meter]'),purchaseFields=form.querySelector('[data-purchase-fields]'),refinanceFields=form.querySelector('[data-refinance-fields]'),priceStepTitle=form.querySelector('[data-price-step-title]'),loanEstimate=form.querySelector('[data-loan-estimate]'),ltvEstimate=form.querySelector('[data-ltv-estimate]');let current=0;const parseAmount=value=>Number(String(value||'').replace(/[^0-9.]/g,''))||0,money=value=>value>0?value.toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}):'',selectedGoal=()=>form.querySelector('input[name="loan_goal"]:checked')?.value||'',isRefinanceGoal=()=>/refinance|cash-out/i.test(selectedGoal());function updateMode(){const refi=isRefinanceGoal();purchaseFields?.classList.toggle('is-hidden',refi);refinanceFields?.classList.toggle('is-hidden',!refi);if(priceStepTitle)priceStepTitle.textContent=refi?'Property value, current balance, and cash out':'Purchase price and down payment';updateEstimate()}function updateEstimate(){let loanAmount=0,ltv=0;if(isRefinanceGoal()){const homeValue=parseAmount(form.querySelector('[data-home-value]')?.value),balance=parseAmount(form.querySelector('[data-current-balance]')?.value),cashOut=parseAmount(form.querySelector('[data-cash-out]')?.value);loanAmount=balance+cashOut;ltv=homeValue>0&&loanAmount>0?loanAmount/homeValue*100:0}else{const purchase=parseAmount(form.querySelector('[data-purchase-price]')?.value),downInput=parseAmount(form.querySelector('[data-down-payment]')?.value),downType=form.querySelector('input[name="down_payment_type"]:checked')?.value||'dollar',downAmount=downType==='percent'?purchase*(downInput/100):downInput;loanAmount=Math.max(purchase-downAmount,0);ltv=purchase>0&&loanAmount>0?loanAmount/purchase*100:0}loanEstimate.textContent=loanAmount>0?money(loanAmount):'Enter numbers to estimate';ltvEstimate.textContent=ltv>0?`Approx. loan-to-value: ${ltv.toFixed(1)}%`:'Loan-to-value will show here.'}function showStep(index){current=Math.max(0,Math.min(index,steps.length-1));steps.forEach((step,i)=>step.classList.toggle('is-active',i===current));label.textContent=`Step ${current+1} of ${steps.length}`;meter.style.width=`${(current+1)/steps.length*100}%`;backBtn.style.display=current===0?'none':'inline-flex';nextBtn.style.display=current===steps.length-1?'none':'inline-flex';submitBtn.style.display=current===steps.length-1?'inline-flex':'none'}function validateStep(){const active=steps[current];for(const field of [...active.querySelectorAll('input,select,textarea')].filter(field=>!field.closest('.is-hidden'))){if(!field.checkValidity()){field.reportValidity();return false}}return true}form.querySelectorAll('input[name="loan_goal"]').forEach(radio=>radio.addEventListener('change',updateMode));form.querySelectorAll('[data-money-input], input[name="down_payment_type"]').forEach(input=>input.addEventListener('input',updateEstimate));form.querySelectorAll('input[name="down_payment_type"]').forEach(input=>input.addEventListener('change',updateEstimate));nextBtn.addEventListener('click',()=>{if(validateStep())showStep(current+1)});backBtn.addEventListener('click',()=>showStep(current-1));updateMode();showStep(0)})();</script>
</BaseLayout>
