---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Privacy Policy | Mortgage Broker Miami Florida";
const description = "Explain how lead form information, calls, texts, analytics, and website data may be used.";
---
<BaseLayout title={title} description={description}>
<main id="main"><section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Trust + compliance</p><h1>Privacy Policy</h1><p>Explain how lead form information, calls, texts, analytics, and website data may be used.</p><div class="hero-actions"><a class="btn btn-primary" href="start.html">Start Review</a><a class="btn btn-secondary" href="contact.html">Contact</a></div><div class="trust-row"><span class="trust-pill">Matthew Gromadzki</span><span class="trust-pill">NMLS #2560919</span></div></div></div></section><section class="section"><div class="container two-col"><article class="prose"><h2>What to include</h2><ul class="check-grid"><li>NMLS/license details</li><li>Business contact information</li><li>No guarantee language</li><li>Lead form consent language</li><li>Rate and calculator disclaimers</li><li>Real review policy</li></ul></article><aside></aside></div></section><section class="section soft"><div class="container"><div class="cta-band"><div><p class="eyebrow">Trust next step</p><h2>Verify the business and then request a scenario review.</h2><p>Trust and compliance pages should support, not replace, the main quote and preapproval paths.</p></div><div class="hero-actions"><a class="btn btn-primary" href="start.html">Start Review</a><a class="btn btn-secondary" href="about.html">About Matthew</a></div></div></div></section></main>
</BaseLayout>
