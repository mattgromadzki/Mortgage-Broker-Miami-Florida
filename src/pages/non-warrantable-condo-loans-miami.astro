"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://mortgagebrokermiamiflorida.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Non-Warrantable Condo Loans in Miami\",\"item\":\"https://mortgagebrokermiamiflorida.com/non-warrantable-condo-loans-miami/\"}]}]</script>";
