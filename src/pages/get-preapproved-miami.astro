---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Get Preapproved for a Mortgage in Miami | Mortgage Broker Miami Florida";
const description = "Start a Miami mortgage preapproval review for FHA, conventional, VA, jumbo, condo, refinance, self-employed, and investor loan options.";
---
<BaseLayout title={title} description={description}>
<main id="main"><section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Preapproval</p><h1>Get Preapproved for a Mortgage in Miami</h1><p>Start a Miami mortgage preapproval review for FHA, conventional, VA, jumbo, condo, refinance, self-employed, and investor loan options.</p><div class="hero-actions"><a class="btn btn-primary" href="start.html">Start Mortgage Review</a><a class="btn btn-secondary" href="get-preapproved-miami.html">Get Preapproved</a><a class="btn btn-secondary" href="mortgage-calculator-florida.html">Calculate Payment</a></div><div class="trust-row"><span class="trust-pill">Matthew Gromadzki</span><span class="trust-pill">NMLS #2560919</span><span class="trust-pill">Miami · Florida</span></div></div><form class="lead-form"><h2>Start Preapproval Review</h2><p>Answer a few basics and we’ll review the best mortgage path for your scenario.</p><label>Loan goal<select><option>Select one</option><option>Buying a home</option><option>Refinancing</option><option>Condo financing</option></select></label><div class="form-row"><label>Purchase price / value<input placeholder="$650,000"></label><label>Down payment / equity<input placeholder="$100,000"></label></div><div class="form-row"><label>Credit score range<select><option>Select range</option><option>760+</option><option>720–759</option><option>680–719</option><option>640–679</option></select></label><label>Property city<input placeholder="Miami"></label></div><div class="form-row"><label>Name<input></label><label>Phone<input></label></div><label>Email<input type="email"></label><button class="btn btn-primary full" type="button">Start Mortgage Review</button><p class="form-note">Preview only. Production form connects to your lead endpoint.</p></form></div></section><section class="section "><div class="container two-col"><article class="prose"><h2>What a strong Miami preapproval should include</h2><p>A useful preapproval reviews income, assets, credit, cash to close, loan type, property type, occupancy, insurance assumptions, association dues, and expected timeline.</p><ul class="check-grid"><li>Purchase price target</li><li>Down payment amount</li><li>Credit score range</li><li>Income type</li><li>Property type</li><li>Condo building if known</li></ul><h2>Preapproval process</h2><div class="process-list"><div class="process-step"><h3>Scenario intake</h3><p>Review goal, city, property type, price, down payment, credit and income type.</p></div><div class="process-step"><h3>Payment and cash-to-close</h3><p>Estimate taxes, insurance, HOA dues, mortgage insurance, closing costs and reserves.</p></div><div class="process-step"><h3>Program comparison</h3><p>Compare FHA, conventional, VA, jumbo, condo, bank statement or DSCR when relevant.</p></div></div></article><aside><div class="content-card"><h2>Useful links</h2><ul><li><a href="mortgage-broker-miami.html">Mortgage Broker Miami</a></li><li><a href="fha-loan-miami.html">FHA Loans Miami</a></li><li><a href="condo-loans-miami.html">Condo Loans Miami</a></li><li><a href="jumbo-loans-miami.html">Jumbo Loans Miami</a></li><li><a href="start.html">Request quote</a></li></ul></div></aside></div></section><section class="section "><div class="container"><p class="eyebrow">Keep comparing</p><h2>Related mortgage pages</h2><div class="card-grid small-grid"><a class="mini-card" href="mortgage-broker-miami.html">Mortgage Broker Miami<span>→</span></a><a class="mini-card" href="miami-mortgage-rates.html">Miami Mortgage Rates<span>→</span></a><a class="mini-card" href="get-preapproved-miami.html">Get Preapproved Miami<span>→</span></a><a class="mini-card" href="start.html">Start Review<span>→</span></a></div></div></section></main>
</BaseLayout>
