---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Miami Mortgage Rates | Mortgage Broker Miami Florida";
const description = "Compare personalized Miami mortgage rate options for conventional, FHA, VA, jumbo, condo, refinance, and investor loans.";
---
<BaseLayout title={title} description={description}>
<main id="main"><section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Mortgage rates</p><h1>Miami Mortgage Rates</h1><p>Compare personalized Miami mortgage rate options for conventional, FHA, VA, jumbo, condo, refinance, and investor loans.</p><div class="hero-actions"><a class="btn btn-primary" href="start.html">Start Mortgage Review</a><a class="btn btn-secondary" href="get-preapproved-miami.html">Get Preapproved</a><a class="btn btn-secondary" href="mortgage-calculator-florida.html">Calculate Payment</a></div><div class="trust-row"><span class="trust-pill">Matthew Gromadzki</span><span class="trust-pill">NMLS #2560919</span><span class="trust-pill">Miami · Florida</span></div></div><form class="lead-form"><h2>Request a Personalized Rate Quote</h2><p>Answer a few basics and we’ll review the best mortgage path for your scenario.</p><label>Loan goal<select><option>Select one</option><option>Buying a home</option><option>Refinancing</option><option>Condo financing</option></select></label><div class="form-row"><label>Purchase price / value<input placeholder="$650,000"></label><label>Down payment / equity<input placeholder="$100,000"></label></div><div class="form-row"><label>Credit score range<select><option>Select range</option><option>760+</option><option>720–759</option><option>680–719</option><option>640–679</option></select></label><label>Property city<input placeholder="Miami"></label></div><div class="form-row"><label>Name<input></label><label>Phone<input></label></div><label>Email<input type="email"></label><button class="btn btn-primary full" type="button">Start Mortgage Review</button><p class="form-note">Preview only. Production form connects to your lead endpoint.</p></form></div></section><section class="section "><div class="container two-col"><article class="prose"><h2>Current rate context</h2><p>Freddie Mac reported the average 30-year fixed-rate mortgage at 6.52% and the 15-year fixed-rate mortgage at 5.84% as of June 11, 2026. These are national weekly averages, not a personal quote.</p><h2>What affects your mortgage rate</h2><table class="seo-table"><thead><tr><th>Factor</th><th>Why it matters</th></tr></thead><tbody><tr><td>Credit score</td><td>Credit tier can affect rate, mortgage insurance and program options.</td></tr><tr><td>Loan-to-value</td><td>Down payment or equity changes risk and pricing.</td></tr><tr><td>Property type</td><td>Condos, investments and second homes can price differently.</td></tr><tr><td>Points and lock period</td><td>A lower rate may require upfront cost and depends on timeline.</td></tr></tbody></table><div class="source-list"><h3>Sources to update</h3><ul><li>Freddie Mac PMMS</li><li>FHFA conforming loan limits</li><li>HUD FHA mortgage limits</li></ul></div></article><aside><div class="content-card"><h2>Useful links</h2><ul><li><a href="mortgage-broker-miami.html">Mortgage Broker Miami</a></li><li><a href="fha-loan-miami.html">FHA Loans Miami</a></li><li><a href="condo-loans-miami.html">Condo Loans Miami</a></li><li><a href="jumbo-loans-miami.html">Jumbo Loans Miami</a></li><li><a href="start.html">Request quote</a></li></ul></div></aside></div></section><section class="section "><div class="container"><p class="eyebrow">Keep comparing</p><h2>Related mortgage pages</h2><div class="card-grid small-grid"><a class="mini-card" href="mortgage-broker-miami.html">Mortgage Broker Miami<span>→</span></a><a class="mini-card" href="miami-mortgage-rates.html">Miami Mortgage Rates<span>→</span></a><a class="mini-card" href="get-preapproved-miami.html">Get Preapproved Miami<span>→</span></a><a class="mini-card" href="start.html">Start Review<span>→</span></a></div></div></section></main>
</BaseLayout>
