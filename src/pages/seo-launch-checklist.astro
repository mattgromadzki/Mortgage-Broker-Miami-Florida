---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "SEO Launch Checklist | Internal";
const description = "";
---
<BaseLayout title={title} description={description}>
<main id="main"><section class="section"><div class="container"><p class="eyebrow">Internal launch QA</p><h1>SEO Launch Checklist</h1><p>This page is noindexed and used to verify build, redirects, sitemap, forms, CRM routing, analytics, call tracking, reviews, and compliance before launch.</p><div class="card-grid"><div class="content-card"><h2>Build</h2><p>Run npm install, npm run build, npm run preview.</p></div><div class="content-card"><h2>Forms</h2><p>Submit quote and scenario forms. Verify CRM and thank-you redirect.</p></div><div class="content-card"><h2>SEO</h2><p>Crawl, check canonicals, titles, metadata, sitemap, and redirects.</p></div></div></div></section></main>
</BaseLayout>
