---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = "Florida Mortgage Calculator | Mortgage Broker Miami Florida";
const description = "Estimate a Florida mortgage payment including principal, interest, taxes, homeowners insurance, HOA dues, and mortgage insurance assumptions.";
---
<BaseLayout title={title} description={description}>
<main id="main"><section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Payment estimate</p><h1>Florida Mortgage Calculator</h1><p>Estimate a Florida mortgage payment including principal, interest, taxes, homeowners insurance, HOA dues, and mortgage insurance assumptions.</p><div class="hero-actions"><a class="btn btn-primary" href="start.html">Start Mortgage Review</a><a class="btn btn-secondary" href="get-preapproved-miami.html">Get Preapproved</a><a class="btn btn-secondary" href="mortgage-calculator-florida.html">Calculate Payment</a></div><div class="trust-row"><span class="trust-pill">Matthew Gromadzki</span><span class="trust-pill">NMLS #2560919</span><span class="trust-pill">Miami · Florida</span></div></div><div class="calculator"><div class="calculator-grid"><label>Home price<input value="650000"></label><label>Down payment<input value="130000"></label><label>Interest rate %<input value="6.50"></label><label>Loan term years<input value="30"></label></div><button class="btn btn-primary full" type="button">Calculate Payment</button><div class="calculator-result"><span>Estimated monthly payment</span><strong>$4,600+</strong><p class="muted">Preview estimate only.</p></div></div><form class="lead-form"><h2>Send My Calculator Scenario</h2><p>Answer a few basics and we’ll review the best mortgage path for your scenario.</p><label>Loan goal<select><option>Select one</option><option>Buying a home</option><option>Refinancing</option><option>Condo financing</option></select></label><div class="form-row"><label>Purchase price / value<input placeholder="$650,000"></label><label>Down payment / equity<input placeholder="$100,000"></label></div><div class="form-row"><label>Credit score range<select><option>Select range</option><option>760+</option><option>720–759</option><option>680–719</option><option>640–679</option></select></label><label>Property city<input placeholder="Miami"></label></div><div class="form-row"><label>Name<input></label><label>Phone<input></label></div><label>Email<input type="email"></label><button class="btn btn-primary full" type="button">Start Mortgage Review</button></form></div></section><section class="section "><div class="container two-col"><article class="prose"><h2>How to use the calculator</h2><p>Enter price, down payment, rate, loan term, taxes, insurance, HOA dues and mortgage insurance. Miami condos often have meaningful HOA dues and insurance considerations, so include realistic estimates.</p><h2>Why your real quote may differ</h2><table class="seo-table"><thead><tr><th>Input</th><th>Why it can change</th></tr></thead><tbody><tr><td>Interest rate</td><td>Changes with market, credit, loan type, points, property type and lock period.</td></tr><tr><td>Taxes</td><td>Can change after purchase price and exemptions.</td></tr><tr><td>Insurance</td><td>Florida insurance varies by property, flood/wind exposure and carrier.</td></tr><tr><td>HOA dues</td><td>Condo dues can materially affect affordability.</td></tr></tbody></table></article><aside><div class="content-card"><h2>Useful links</h2><ul><li><a href="mortgage-broker-miami.html">Mortgage Broker Miami</a></li><li><a href="fha-loan-miami.html">FHA Loans Miami</a></li><li><a href="condo-loans-miami.html">Condo Loans Miami</a></li><li><a href="jumbo-loans-miami.html">Jumbo Loans Miami</a></li><li><a href="start.html">Request quote</a></li></ul></div></aside></div></section><section class="section "><div class="container"><p class="eyebrow">Keep comparing</p><h2>Related mortgage pages</h2><div class="card-grid small-grid"><a class="mini-card" href="mortgage-broker-miami.html">Mortgage Broker Miami<span>→</span></a><a class="mini-card" href="miami-mortgage-rates.html">Miami Mortgage Rates<span>→</span></a><a class="mini-card" href="get-preapproved-miami.html">Get Preapproved Miami<span>→</span></a><a class="mini-card" href="start.html">Start Review<span>→</span></a></div></div></section></main>
</BaseLayout>
